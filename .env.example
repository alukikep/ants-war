# ============================================================================
# ⚠️ 重要安全警告 ⚠️
# ============================================================================
# VITE_DEEPSEEK_API_KEY 会被 Vite **编译期注入到前端 bundle**！
# 任何访问你部署网站的人（包括你部署到 GitHub Pages 后全网用户）都可以在
# 浏览器 DevTools → Sources 里看到这个 key 的明文。
#
# 因此：
# 1. **强烈不建议在 .env 里填写真实 API Key**
# 2. 游戏运行时通过 UI（设置按钮 ⚙️）输入 Key：仅保存在内存，不打包到 bundle
# 3. 如果你确实需要本地 dev 调试，请使用一个**专用、有限额、随时可 revoke 的 key**
#
# VITE_DEEPSEEK_BASE_URL / VITE_DEEPSEEK_MODEL / VITE_DEEPSEEK_TIMEOUT_MS /
# VITE_DEEPSEEK_THROTTLE_MS 这些**不是密钥**，可以安全放在 .env 里。
# ============================================================================

# DeepSeek API Key — ⚠️ 不推荐在这里填写！建议在游戏 UI 里输入。
# 获取地址: https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek 接口地址（默认官方，可改为 OpenAI 兼容服务）
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型：deepseek-chat (V3, 推荐) 或 deepseek-reasoner (R1, 带推理链)
VITE_DEEPSEEK_MODEL=deepseek-chat

# 决策请求超时（毫秒），LLM 调用通常需要 3-10s
VITE_DEEPSEEK_TIMEOUT_MS=15000

# 决策最小间隔（毫秒）
VITE_DEEPSEEK_THROTTLE_MS=1500
